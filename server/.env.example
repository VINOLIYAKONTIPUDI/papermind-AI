# Server Port Configuration
PORT=5000

# MongoDB Connection URI (Falls back to high-performance in-memory mode if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/papermind

# Qdrant Vector Database URL
QDRANT_URL=http://127.0.0.1:6333

# Gemini API Configuration (Get yours from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# RAG Pipeline Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.3
