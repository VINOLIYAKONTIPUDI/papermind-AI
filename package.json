{
  "name": "papermind-ai",
  "version": "1.0.0",
  "description": "PaperMind AI — RAG Research Assistant",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npx concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:rag": "npm run test:rag --prefix server",
    "test:real": "npm run test:real --prefix server",
    "evaluate": "npm run evaluate --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
